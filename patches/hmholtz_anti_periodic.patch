+c-----------------------------------------------------------------------
+      subroutine dssum_ap_flip(u, nx, ny, nz)
+c
+c     dssum with anti-periodic flip for VELX/VELY fields.
+c     Negates secondary periodic nodes before/after dssum
+c     so anti-periodic components average correctly.
+c
+      include 'SIZE'
+      include 'TSTEP'
+
+      real u(1)
+
+      integer lnp
+      parameter (lnp = lx1*ly1*lz1*lelt)
+
+      integer pflip_vel(lnp)
+      logical if_ap_setup
+      common /ap_flip_data/ pflip_vel, if_ap_setup
+
+      logical if_do_flip
+      common /ap_flip_flag/ if_do_flip
+
+      integer i, n
+
+      if (.not. if_ap_setup .or. .not. if_do_flip) then
+         call dssum(u, nx, ny, nz)
+         return
+      endif
+
+      n = nx*ny*nz*nelfld(ifield)
+      if (istep.eq.1 .and. nid.eq.0) then
+         nflip = 0
+         umin_sec = 1e30
+         umax_sec = -1e30
+         do i = 1, n
+            if (pflip_vel(i) .eq. -1) then
+               nflip = nflip + 1
+               if (u(i).lt.umin_sec) umin_sec = u(i)
+               if (u(i).gt.umax_sec) umax_sec = u(i)
+            endif
+         enddo
+         write(6,*) 'APFLIP PRE step=', istep,
+     &     ' nflip=', nflip, ' sec_range=',
+     &     umin_sec, umax_sec
+      endif
 
+c     Negate at secondary periodic nodes
+      do i = 1, n
+         if (pflip_vel(i) .eq. -1) u(i) = -u(i)
+      enddo
+
+c     Standard dssum
+      call dssum(u, nx, ny, nz)
+
+c     Post-dssum diagnostic
+      if (istep.eq.1 .and. nid.eq.0) then
+         umin_sec = 1e30
+         umax_sec = -1e30
+         umin_pri = 1e30
+         umax_pri = -1e30
+         do i = 1, n
+            if (pflip_vel(i) .eq. -1) then
+               if (u(i).lt.umin_sec) umin_sec = u(i)
+               if (u(i).gt.umax_sec) umax_sec = u(i)
+            endif
+         enddo
+         write(6,*) 'APFLIP POST-DSSUM sec_range=',
+     &     umin_sec, umax_sec
+      endif
+
+c     Negate back
+      do i = 1, n
+         if (pflip_vel(i) .eq. -1) u(i) = -u(i)
+      enddo
+
+      if (istep.eq.1 .and. nid.eq.0) then
+         umin_sec = 1e30
+         umax_sec = -1e30
+         do i = 1, n
+            if (pflip_vel(i) .eq. -1) then
+               if (u(i).lt.umin_sec) umin_sec = u(i)
+               if (u(i).gt.umax_sec) umax_sec = u(i)
+            endif
+         enddo
+         write(6,*) 'APFLIP FINAL sec_range=',
+     &     umin_sec, umax_sec
+      endif
+
       return
       end
 c-----------------------------------------------------------------------
+      subroutine set_ap_flag(flag)
+      logical flag
+      logical if_do_flip
+      common /ap_flip_flag/ if_do_flip
+      if_do_flip = flag
+      return
+      end
+c-----------------------------------------------------------------------
+      block data ap_flip_init
+      include 'SIZE'
+      integer lnp
+      parameter (lnp = lx1*ly1*lz1*lelt)
+      integer pflip_vel(lnp)
+      logical if_ap_setup
+      common /ap_flip_data/ pflip_vel, if_ap_setup
+      logical if_do_flip
+      common /ap_flip_flag/ if_do_flip
+      data if_ap_setup /.false./
+      data if_do_flip  /.false./
+      end
+c-----------------------------------------------------------------------
