c-----------------------------------------------------------------------
c  nek5000 user-file template
c
c  user specified routines:
c     - uservp  : variable properties
c     - userf   : local acceleration term for fluid
c     - userq   : local source term for scalars
c     - userbc  : boundary conditions
c     - useric  : initial conditions
c     - userchk : general purpose routine for checking errors etc.
c     - userqtl : thermal divergence for lowMach number flows 
c     - usrdat  : modify element vertices 
c     - usrdat2 : modify mesh coordinates
c     - usrdat3 : general purpose routine for initialization
c     
c-----------------------------------------------------------------------
      subroutine uservp(ix,iy,iz,eg) ! set variable properties

c      implicit none

      integer ix,iy,iz,eg
     
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
c     e = gllel(eg)

      udiff  = 0.0
      utrans = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
c
c     Note: this is an acceleration term, NOT a force!
c     Thus, ffx will subsequently be multiplied by rho(x,t).
c
c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
c     e = gllel(eg)

      real Rat,Ra,Ek,Prandtl

      Rat = uparam(1)
      Ek = uparam(2)
      Ra = Rat*(Ek)**(-4.0/3.0)

      Prandtl = 1/param(8)

      !ffx = 0.0
      !ffy = 0.0

      ffx = uy/Ek
      ffy = -ux/Ek
      ffz = (Ra/Prandtl)*temp

      return
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,eg) ! set source term

c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
c     e = gllel(eg)

      qvol   = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg) ! set up boundary conditions
c
c     NOTE ::: This subroutine MAY NOT be called by every process
c
c      implicit none

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      
      integer ix,iy,iz,iside,eg,iel

      iel = gllel(eg) ! MUST define iel from global element index eg 

      ! Default values
      ux=0.0
      uy=0.0
      uz=0.0
      temp=0.0

      if (ifield .eq. 2) then ! Temperature field
         id = boundaryID(iside,iel)
         if (id .eq. 2) then
            temp = 1.0  ! Hot bottom plate
         elseif (id .eq. 3) then
            temp = 0.0  ! Cold top plate
         endif
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions

c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ux   = 0.0
      uy   = 0.0
      uz   = 0.0

c     Initial condition for temperature = conductive profile (1-z) + a seed.
c     uparam(4) selects the seed:  0 = random noise;  1 = Cartesian hexagonal
c     tessellation at the critical wavenumber a_c = k_c*H = 1.3048*Ek^{-1/3},
c     with sin(pi*z) vertical structure so it vanishes at both fixed-T plates.
      if (uparam(4) .gt. 0.5) then
         pi  = 4.0*atan(1.0)
         ac  = 1.3048*(uparam(2))**(-1.0/3.0)
         s3  = sqrt(3.0)
         hexpat =        cos(ac*x)
     &          + cos(ac*(-0.5*x + 0.5*s3*y))
     &          + cos(ac*(-0.5*x - 0.5*s3*y))
         temp = (1.0 - z) + 1.0e-2*sin(pi*z)*hexpat
      else
         temp = (1.0 - z) + 1.0e-4*rand()
      endif

      return
      end
